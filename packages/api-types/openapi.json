    "/api/v1/locations/{location_id}/forecast-history": {
      "get": {
        "operationId": "get_forecast_history_api_v1_locations__location_id__forecast_history_get",
        "parameters": [
          {
            "in": "path",
            "name": "location_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Location Id",
              "type": "string"
            }
          },
          {
            "description": "Target hour. Without an offset it is read in the location's timezone.",
            "in": "query",
            "name": "target_time",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Target hour. Without an offset it is read in the location's timezone.",
              "title": "Target Time"
            }
          },
          {
            "description": "Target local date (daily history).",
            "in": "query",
            "name": "target_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Target local date (daily history).",
              "title": "Target Date"
            }
          },
          {
            "in": "query",
            "name": "metric",
            "required": false,
            "schema": {
              "default": "temperature",
              "enum": [
                "temperature",
                "precipitation",
                "wind"
              ],
              "title": "Metric",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastHistory"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Forecast History",
        "tags": [
          "locations"
        ]
      }
    },
