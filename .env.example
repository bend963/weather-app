# Copy to .env for running the API/worker outside Docker (`make dev-local`).
# Never commit real values. In production these come from Cloud Run secrets /
# Secret Manager (API, worker) and Vercel environment variables (web).

# --- API + worker -----------------------------------------------------------
ENVIRONMENT=development
# SQLAlchemy URL (psycopg 3 driver). Supabase: use the pooler connection string.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/weather

# mock | weathernext
FORECAST_PROVIDER=mock
# How many recent model runs to keep filled for each active grid point.
INGESTION_BACKFILL_RUNS=8
# Days before a grid point no saved location uses stops being ingested.
GRID_POINT_INACTIVE_DAYS=14

# WeatherNext (Milestone 5). Locally, point GOOGLE_APPLICATION_CREDENTIALS at a
# service account key or use `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
WEATHERNEXT_BIGQUERY_DATASET=

# nominatim (development) | static (offline gazetteer, used by tests)
GEOCODER_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
# NWS and Nominatim require an identifying User-Agent with contact details.
NWS_USER_AGENT=weathernext-personal-weather-app (you@example.com)

# Signs the anonymous visitor cookie. Generate with: openssl rand -base64 48
COOKIE_SECRET=dev-only-insecure-cookie-secret-change-me
# Comma-separated origins allowed to call the API directly (the web app proxies, so
# this mostly matters for local tools).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Web (Next.js) ------------------------------------------------------------
# Where Next.js proxies /api/v1/* (server-side; baked in at build time).
API_ORIGIN=http://localhost:8000
# Base URL the browser uses for API calls. Leave empty to call the same origin,
# which keeps the visitor cookie first-party. Only set it if the API is served
# from the same site under another path.
NEXT_PUBLIC_API_URL=
