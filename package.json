{
  "name": "weather-app",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @weather/web",
    "build": "npm run build -w @weather/web",
    "lint": "npm run lint -w @weather/web",
    "typecheck": "npm run typecheck -w @weather/web",
    "test": "npm run test -w @weather/web",
    "e2e": "npm run e2e -w @weather/web",
    "types:generate": "npm run generate -w @weather/api-types"
  },
  "engines": {
    "node": ">=20.9"
  }
}
